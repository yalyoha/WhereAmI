<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/settings_keep_bg_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:trackTint="@color/brand_dark"
        app:trackDecorationTint="@color/brand_dark"
        app:thumbTint="@color/brand_orange"
        android:textColor="@color/brand_on_gradient"
        android:text="@string/keep_bg_switch" />

    <TextView
        android:id="@+id/settings_keep_bg_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/brand_on_gradient"
        android:text="@string/keep_bg_hint" />

    <TextView
        android:id="@+id/settings_batt_opt_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/brand_on_gradient"
        tools:text="Батарея: работать без ограничений ✅" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/settings_installed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/brand_on_gradient"
        tools:text="Установлено: v4.0 · build 13" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/settings_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/brand_on_gradient"
            tools:text="На GitHub: v4.0 · build 13" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_update_btn"
            style="@style/Widget.WhereAmI.Button.Period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:enabled="false"
            android:text="@string/settings_update_btn" />
    </LinearLayout>

    <TextView
        android:id="@+id/settings_open_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/brand_on_gradient"
        android:text="@string/settings_open_log" />

    <TextView
        android:id="@+id/settings_logout_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="@color/brand_on_gradient"
        android:text="@string/btn_logout" />
</LinearLayout>
