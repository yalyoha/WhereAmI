<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0f14">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/log_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111820"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:title="@string/log_title" />

    <TextView
        android:id="@+id/log_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:textColor="#6b7480"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="#0e141b"
        tools:ignore="MissingDefaultResource"
        xmlns:tools="http://schemas.android.com/tools"
        tools:text="128 KB · path=/data/data/.../logs" />

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="#cfe3ff"
            android:textIsSelectable="true"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
