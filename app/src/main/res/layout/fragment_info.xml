<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/info_keep_bg_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/keep_bg_switch" />

    <TextView
        android:id="@+id/info_keep_bg_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:text="@string/keep_bg_hint" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/info_period_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/info_period_today"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/period_today" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/info_period_week"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/period_week" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/info_period_month"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/period_month" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/info_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textSize="32sp"
        android:textStyle="bold"
        tools:text="12.5 км"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/info_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textSize="16sp"
        tools:text="Точек: 128"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/info_first_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="С 00:15 до 23:42"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/info_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="?attr/colorError"
        tools:text=""
        xmlns:tools="http://schemas.android.com/tools" />
</LinearLayout>
